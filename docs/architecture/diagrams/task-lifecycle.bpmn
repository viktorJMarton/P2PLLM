<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Task" targetNamespace="https://example.invalid/p2pai/spec"><bpmn:process id="Process_Task" name="Private shared compute task" isExecutable="false"><bpmn:startEvent id="Start" name="Request"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="Validate" name="Validate privacy and compatibility"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Allowed" name="Admissible?" default="FReject"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>FAccept</bpmn:outgoing><bpmn:outgoing>FReject</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Execute" name="Protected computation"><bpmn:incoming>FAccept</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task><bpmn:task id="Check" name="Validate result"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Done" name="Completed"><bpmn:incoming>F4</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="Reject" name="Rejected"><bpmn:incoming>FReject</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="Abort" name="Backend failure" attachedToRef="Execute" cancelActivity="true"><bpmn:outgoing>FAbort</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorDef_Abort" /></bpmn:boundaryEvent><bpmn:task id="Cleanup" name="Release resources"><bpmn:incoming>FAbort</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Failed" name="Failed / cancelled"><bpmn:incoming>F5</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Validate" /><bpmn:sequenceFlow id="F2" sourceRef="Validate" targetRef="Allowed" /><bpmn:sequenceFlow id="FAccept" sourceRef="Allowed" targetRef="Execute"><bpmn:conditionExpression>privacyApproved AND compatible AND resourcesAvailable</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="FReject" sourceRef="Allowed" targetRef="Reject" /><bpmn:sequenceFlow id="F3" sourceRef="Execute" targetRef="Check" /><bpmn:sequenceFlow id="F4" sourceRef="Check" targetRef="Done" /><bpmn:sequenceFlow id="FAbort" sourceRef="Abort" targetRef="Cleanup" /><bpmn:sequenceFlow id="F5" sourceRef="Cleanup" targetRef="Failed" /></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Task"><bpmndi:BPMNPlane id="Plane_Task" bpmnElement="Process_Task"><bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="40" y="100" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Validate"><dc:Bounds x="110" y="78" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Allowed" bpmnElement="Allowed"><dc:Bounds x="295" y="93" width="50" height="50" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Execute" bpmnElement="Execute"><dc:Bounds x="400" y="78" width="140" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check"><dc:Bounds x="600" y="78" width="120" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Done" bpmnElement="Done"><dc:Bounds x="790" y="100" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Reject" bpmnElement="Reject"><dc:Bounds x="302" y="260" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Abort" bpmnElement="Abort"><dc:Bounds x="480" y="140" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Cleanup" bpmnElement="Cleanup"><dc:Bounds x="560" y="240" width="130" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_Failed" bpmnElement="Failed"><dc:Bounds x="790" y="260" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_F1" bpmnElement="F1"><di:waypoint x="76" y="118" /><di:waypoint x="110" y="118" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_F2" bpmnElement="F2"><di:waypoint x="250" y="118" /><di:waypoint x="295" y="118" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_FAccept" bpmnElement="FAccept"><di:waypoint x="345" y="118" /><di:waypoint x="400" y="118" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_FReject" bpmnElement="FReject"><di:waypoint x="320" y="143" /><di:waypoint x="320" y="260" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_F3" bpmnElement="F3"><di:waypoint x="540" y="118" /><di:waypoint x="600" y="118" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_F4" bpmnElement="F4"><di:waypoint x="720" y="118" /><di:waypoint x="790" y="118" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_FAbort" bpmnElement="FAbort"><di:waypoint x="498" y="176" /><di:waypoint x="498" y="280" /><di:waypoint x="560" y="280" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_F5" bpmnElement="F5"><di:waypoint x="690" y="280" /><di:waypoint x="790" y="280" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
